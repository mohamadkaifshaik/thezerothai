# Code owners for the files that act as safety gates. The branch ruleset on main does not require code-owner review
# (as of 2026-11-03), so this file only auto-requests the owner as a reviewer on PRs that touch these paths.

# fieldOverrides acknowledgement and the check that enforces it (a new single-field exemption can remove indexing: not additive)
/firebase/field-overrides.ack                  @mohamadkaifshaik
/scripts/promotion/check-field-overrides.sh    @mohamadkaifshaik
/firebase/firestore.indexes.json               @mohamadkaifshaik

# feature-flag and scaling ceilings that the promotion validators enforce
/scripts/promotion/flag-ceiling.json           @mohamadkaifshaik

# every workflow (the App identity holds Workflows: write, so any workflow file could otherwise change CI or deploys unseen;
# deploy-dev.yml is the one that can change dev: traffic, rules, indexes, Hosting) and the ownership file itself
/.github/workflows/                            @mohamadkaifshaik
/.github/CODEOWNERS                            @mohamadkaifshaik

# mints the assistant's GitHub App credentials (signs a JWT with the App key and exchanges it for an installation token)
/scripts/mint-app-token.sh                     @mohamadkaifshaik

# agent instructions (CLAUDE.md, .claude/: removed 2026-11-03, kept owned so any re-added copy still needs review) define its rules,
# so changing them always needs the owner's code-owner review, even if the ruleset is ever relaxed
/CLAUDE.md                                     @mohamadkaifshaik
/.claude/                                      @mohamadkaifshaik
