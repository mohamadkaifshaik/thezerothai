rules_version = '2';

// Deny-all for clients (ADR-0003). Only the Go API touches Firestore, via the Admin SDK,
// which bypasses these rules. Clients never read or write Firestore directly: this is what
// makes the per-RPC read/write budgets enforceable and keeps scraping off the free quota.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
