# Shell scripts and Makefiles must stay LF even on Windows checkouts (core.autocrlf=true), or bash/make break.
*.sh      text eol=lf
Makefile  text eol=lf
*.go      text eol=lf

# Flutter regenerates these as LF on every pub get/analyze/test; keep them LF on Windows checkouts so they never show as modified.
app/linux/flutter/generated_plugin*   text eol=lf
app/macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
app/windows/flutter/generated_plugin*   text eol=lf

# Promotion scripts, ceiling and fixtures: LF always, or CRLF breaks bash string comparisons and jq output diffs.
scripts/promotion/** text eol=lf

# Markdown stays LF: the release workflows grep whole lines in docs/reviews/release-*-readiness.md for `VERDICT: GO`, so a stray CR
# would make them fail closed; core.autocrlf=true Windows checkouts would otherwise risk it.
*.md      text eol=lf
