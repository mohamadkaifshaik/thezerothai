{
  "_comment": "Per-env ceiling for server feature flags and Cloud Run shape. A revision may be promoted only if every flag's EFFECTIVE mode is <= the ceiling. Raising a ceiling is a reviewed PR. Allowlist uids are never stored here, only counts. Order: off < allowlist < percent < on.",
  "flags": ["ACCOUNT_LIFECYCLE", "CONTENT_DISCLOSURE", "ENGAGEMENT", "GRAPH", "MEDIA", "NOTIFICATIONS", "POSTS", "PROFILE_SNAPSHOT", "QUOTES", "REMOVED_IDS", "REPLIES", "REPORTS", "UI_SHELL"],
  "unset_default": {
    "_comment": "Mode when FEATURE_<N> is unset, from backend/pkg/platform/config/config.go (graph/posts: on in dev, off in prod; all others off). check-flag-registry.sh re-derives this from config.go.",
    "dev": {"GRAPH": "on", "POSTS": "on"},
    "prod": {}
  },
  "envs": {
    "dev": {
      "max_instances": 3,
      "min_instances": 0,
      "allowed_tags": ["cand", "p8-t1", "candidate", "last-good"],
      "flags": {
        "ACCOUNT_LIFECYCLE": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "CONTENT_DISCLOSURE": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "ENGAGEMENT": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "GRAPH": {"mode": "on"},
        "MEDIA": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "NOTIFICATIONS": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "POSTS": {"mode": "on"},
        "PROFILE_SNAPSHOT": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "QUOTES": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "REMOVED_IDS": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "REPLIES": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "REPORTS": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0},
        "UI_SHELL": {"mode": "allowlist", "max_allowlist": 3, "max_percent": 0}
      }
    }
  }
}
