# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars — it's in .gitignore, but double-check before
# `git add`.

project_id      = "dzeroth-dev"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
github_repo     = "your-org/thezerothai"

founder_emails = [
  "founder1@example.com",
]

region              = "asia-south1"
# PERMANENT once created — confirm with the human before first apply.
firestore_location  = "asia-south1"
media_bucket_region = "us-central1"

# Must exactly match the web app's real origins once deployed (Firebase
# Hosting default domain + custom domain, if any). GCS CORS does not support
# wildcard ports/domains.
cors_origins = [
  "https://dev.dzeroth.com",
  "https://dzeroth-dev.web.app",
  "https://dzeroth-dev.firebaseapp.com",
  "http://localhost:5000",
  "http://localhost:8080",
]

android_package_name = "com.dzeroth.dzeroth"
ios_bundle_id         = "com.dzeroth.dzeroth"

# Must be globally unique across ALL Firebase projects, not just yours.
hosting_site_id = "dzeroth-dev"

# Must match the billing account currency. Alert threshold: Stage 0 is about INR 434/month at 300 DAU (ADR-0022).
budget_amount        = 500
budget_currency_code = "INR"

# From: gcloud services api-keys list --project=dzeroth-dev --format="table(uid,displayName)"
browser_key_uid = "00000000-0000-0000-0000-000000000000" # Browser key (auto created by Firebase)
android_key_uid = "00000000-0000-0000-0000-000000000000" # Android key (auto created by Firebase)
ios_key_uid     = "00000000-0000-0000-0000-000000000000" # iOS key (auto created by Firebase)

# Manual cron testing in dev (ADR-0021 D1, security review L-5). OPT-IN: leave both commented out and nothing is created.
# The founder decides whether to set them. Together they create ONE time-boxed IAM binding
# on the dev pubsub-push service account: roles/iam.serviceAccountOpenIdTokenCreator (only getOpenIdToken) for ONE
# person ("user:" only: a service account, group or domain is refused), with an IAM condition that stops it working at
# the expiry. The expiry is REQUIRED with the invoker, in the exact UTC form below; `terraform plan` refuses one that is
# already past or more than 31 days away (30 days after the apply is the intended maximum). After the expiry the
# binding is inert but stays in the policy, and local plans fail until both lines are cleared and applied (that
# deletes the binding). CI's plan (dev) shows the binding as a destroy while it exists: expected, CI never applies.
# Dev only; envs/prod has no such variable and must never get this grant.
# cron_test_invoker        = "user:someone@example.com"
# cron_test_invoker_expiry = "2026-11-24T00:00:00Z" # example: 30 days after the apply date

# W3 Part A rollout, dev (ADR-0024, W3-24; runbook docs/runbooks/w3-part-a-rollout.md). OPT-IN, founder decision: leave these
# commented out and the four W3 flags stay `off` (the variable defaults). Never put real uids in this file or in any committed
# file; they live only in the gitignored terraform.tfvars.
# - The cohort is the same 3 testers as feature_bookmarks_allowlist / feature_engagement_allowlist / feature_media_allowlist
#   (Terraform does not check the subset rule, so keep them equal by hand): likes_list ramps WITH bookmarks and engagement,
#   profile_extras (banner) needs media, follow_suggestions needs graph (on in dev).
# - Dev ceilings (scripts/promotion/flag-ceiling.json): allowlist, at most 3 uids, percent 0. Do not exceed them.
# - profile_tabs never leaves `off` before the two W3-2 posts indexes are READY and `opsctl backfill-has-media` has run in dev.
# - suggested_user_ids is the curated "who to follow" fallback (at most 20 uids, not a secret). Empty (the default): a user who
#   follows fewer than 3 accounts sees an empty card. A founder choice; the runbook proposes the 3 test uids for dev.
# feature_profile_extras               = "allowlist"
# feature_profile_extras_allowlist     = "<uid-1>,<uid-2>,<uid-3>"
# feature_profile_tabs                 = "allowlist"
# feature_profile_tabs_allowlist       = "<uid-1>,<uid-2>,<uid-3>"
# feature_likes_list                   = "allowlist"
# feature_likes_list_allowlist         = "<uid-1>,<uid-2>,<uid-3>"
# feature_follow_suggestions           = "allowlist"
# feature_follow_suggestions_allowlist = "<uid-1>,<uid-2>,<uid-3>"
# suggested_user_ids                   = "<uid-1>,<uid-2>,<uid-3>"

# W3 Part B (ADR-0025, W3-25b): private accounts. OPT-IN, founder decision (question B4); the flag stays `off` until W3-38. Dev ceiling:
# allowlist, at most 3 uids, percent 0; there is no prod entry. The four limits are literals in main.tf (config.go defaults).
# feature_private_accounts           = "allowlist"
# feature_private_accounts_allowlist = "<uid-1>,<uid-2>,<uid-3>"

# W8 coming-soon pages (ADR-0026, W8-11; runbook docs/runbooks/shells.md "Dev rollout"). OPT-IN: leave commented out and `shells`
# stays `off`. The cohort is the same 3 testers as feature_ui_shell_allowlist (entries need shells AND ui_shell). Dev ceiling:
# allowlist, at most 3 uids, percent 0.
# feature_shells           = "allowlist"
# feature_shells_allowlist = "<uid-1>,<uid-2>,<uid-3>"

# W4 (ADR-0028 D8, W4-3): search and trends. Default off. Dev ceiling: allowlist, at most 6 uids, percent 0; no prod raise.
# trends never ramps ahead of search (the trend rows link to search).
# feature_search           = "allowlist"
# feature_search_allowlist = "<uid-1>,<uid-2>,<uid-3>"
# feature_trends           = "allowlist"
# feature_trends_allowlist = "<uid-1>,<uid-2>,<uid-3>"
