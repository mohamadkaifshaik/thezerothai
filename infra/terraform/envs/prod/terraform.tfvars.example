# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars — it's in .gitignore, but double-check before
# `git add`.

project_id      = "dzeroth-prod"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
github_repo     = "your-org/thezerothai"

founder_emails = [
  "founder1@example.com",
]

region = "asia-south1"
# PERMANENT once created — confirm with the human before first apply.
firestore_location  = "asia-south1"
media_bucket_region = "us-central1"

# Production web app origins only (no localhost). GCS CORS does not support
# wildcard ports/domains — list every real origin explicitly, including the
# custom domain once attached to Firebase Hosting.
cors_origins = [
  "https://dzeroth.com",
  "https://dzeroth-prod.web.app",
  "https://dzeroth-prod.firebaseapp.com",
]

android_package_name = "com.dzeroth.dzeroth"
ios_bundle_id         = "com.dzeroth.dzeroth"

# Must be globally unique across ALL Firebase projects, not just yours.
hosting_site_id = "dzeroth-prod"

# Must match the billing account currency; ~US$5.
budget_amount        = 500
budget_currency_code = "INR"

# From: gcloud services api-keys list --project=dzeroth-prod --format="table(uid,displayName)"
browser_key_uid = "00000000-0000-0000-0000-000000000000" # Browser key (auto created by Firebase)
android_key_uid = "00000000-0000-0000-0000-000000000000" # Android key (auto created by Firebase)
ios_key_uid     = "00000000-0000-0000-0000-000000000000" # iOS key (auto created by Firebase)
